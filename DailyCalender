      "parameters": {
        "jsCode": "// Pick Places (3 tries, NO repetition)\n\nconst places = [\n  { name: \"دروازه براندنبورگ\", city: \"برلین\", file: \"Brandenburg-Gate-Berlin.jpg\" },\n  { name: \"قلعه نوی‌شوانشتاین\", city: \"بایرن\", file: \"Schloss Neuschwanstein 2013.jpg\" },\n  { name: \"کلیسای جامع کلن\", city: \"کلن\", file: \"Kölner Dom Panorama.jpg\" },\n  { name: \"الب‌فیلارمونی\", city: \"هامبورگ\", file: \"Elbphilharmonie-Hamburg.jpg\" }\n];\n\nfunction shuffle(arr){\n  const a = arr.slice();\n  for(let i=a.length-1;i>0;i--){\n    const j = Math.floor(Math.random()*(i+1));\n    [a[i],a[j]]=[a[j],a[i]];\n  }\n  return a;\n}\n\nfunction toIsoDate(d){\n  return d.toISOString().slice(0,10);\n}\n\nconst sd = $getWorkflowStaticData('global');\nconst todayKey = toIsoDate(new Date());\n\nif(sd.daily_calendar_last_date === todayKey) return [];\n\nif(!Array.isArray(sd.daily_places_bag) || sd.daily_places_bag.length===0){\n  sd.daily_places_bag = shuffle(places.map((_,i)=>i));\n}\n\nconst out = [];\nconst maxAttempts = Math.min(3, places.length);\n\nfor(let i=0;i<maxAttempts;i++){\n  if(sd.daily_places_bag.length===0){\n    sd.daily_places_bag = shuffle(places.map((_,i)=>i));\n  }\n  const idx = sd.daily_places_bag.pop();\n  const place = {...places[idx]};\n  const fileEnc = encodeURIComponent(place.file);\n  place.url = `https://commons.wikimedia.org/wiki/Special:FilePath/${fileEnc}?width=1600`;\n  out.push({json:{place,todayKey}});\n}\n\nreturn out;"
      },
